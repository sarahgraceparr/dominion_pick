{
  "name": "dominion-pick",
  "version": "0.1.0",
  "description": "Picks fun, synergistic Dominion kingdoms. A static PWA for web and Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:data": "tsx scripts/build-card-data.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "analyze:recommended": "tsx scripts/analyze-recommended.ts docs/recommended-kingdoms.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarahgraceparr/dominion_pick.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sarahgraceparr/dominion_pick/issues"
  },
  "homepage": "https://github.com/sarahgraceparr/dominion_pick#readme",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
